                        i = i + 1;
                    }

                    X[rd] = X[rs1] | mask;
                }
            }
        }
        CV_BITREV {
            // Bits 29:27 must be zero; only bits 26:25 encode Is3.
            encoding: 2'b11 :: 3'b000 :: Luimm2[1:0] :: Iuimm5[4:0] :: rs1[4:0] :: 3'b001 :: rd[4:0] :: 7'b1011011;
            assembly: {"cv.bitrev", "{name(rd)}, {name(rs1)}, {Luimm2}, {Iuimm5}" };
            behavior: {
                // Warning: UNTESTED
                if (rd != 0) {
                    unsigned<32> source = X[rs1] << Iuimm5;
                    unsigned<32> result = 0;

                    unsigned<3> groupWidth = 1;
                    unsigned<3> firstWidth = 1;
                    unsigned<6> sourceBase = 0;
                    unsigned<6> destinationBase = 0;
                    unsigned<6> chunkWidth = 0;
                    unsigned<6> i = 0;

                    // Is3 == 3 behaves like Is3 == 0.
                    if (Luimm2 == 1) {
                        groupWidth = 2;
                    } else if (Luimm2 == 2) {
                        groupWidth = 3;
                    }

                    firstWidth = 32 % groupWidth;
                    if (firstWidth == 0) {
                        firstWidth = groupWidth;
                    }

                    chunkWidth = firstWidth;

                    while (sourceBase < 32) {
                        destinationBase = 32 - sourceBase - chunkWidth;
                        i = 0;

                        // Preserve the bit order within each group.
                        while (i < chunkWidth) {
                            if (((source >> (sourceBase + i)) & 1) != 0) {
                                result = result |
                                         (1 << (destinationBase + i));
                            }
                            i = i + 1;
                        }

                        sourceBase = sourceBase + chunkWidth;
                        chunkWidth = groupWidth;
                    }

                    X[rd] = result;
                }
            }
        }
        // SOURCE FILE: instr_srcs/XCoreVALU_BitmanipR.txt
        CV_EXTRACTR {
            encoding: 7'b0011000 :: rs2[4:0] :: rs1[4:0] :: 3'b011 :: rd[4:0] :: 7'b0101011;
            assembly: {"cv.extractr", "{name(rd)}, {name(rs1)}, {name(rs2)}" };
            behavior: {
                if (rd != 0) {
                    X[rd] = (signed<32>)(((X[rs1] >> X[rs2][31: 0][4:0]) & ((2 << X[rs2][31: 0][9:5]) - 1)) << (31 - X[rs2][31: 0][9:5])) >> (31 - X[rs2][31: 0][9:5]);
                }
            }
        }
