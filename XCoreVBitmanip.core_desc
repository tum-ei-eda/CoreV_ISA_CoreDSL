                // Warning: UNTESTED
                if (rd != 0) {
                    unsigned<5> offset = X[rs2][4:0];
                    unsigned<6> width = X[rs2][9:5] + 1;
                    unsigned<32> mask = 0;
                    unsigned<6> i = 0;

                    if (width > (32 - offset)) {
                        width = 32 - offset;
                    }

                    while (i < width) {
                        mask = mask | (1 << (offset + i));
                        i = i + 1;
                    }

                    X[rd] = (X[rd] & ~mask) |
                            ((X[rs1] << offset) & mask);
                }
            }
        }
