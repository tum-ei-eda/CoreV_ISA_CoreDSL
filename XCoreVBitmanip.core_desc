            return (x << n) | (x >> (32 - n));
            // return (x << n) | (x >> (-(n)&31));
        }
        unsigned<32> rotr32(unsigned<32> x, unsigned<32> n) [[inline]] {
            return (x >> n) | (x << (32 - n));
            // return (x >> n) | (x << (-(n)&31));
