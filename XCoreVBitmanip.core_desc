        CV_INSERTR {
            encoding: 7'b0011010 :: rs2[4:0] :: rs1[4:0] :: 3'b011 :: rd[4:0] :: 7'b0101011;
            assembly: {"cv.insertr", "{name(rd)}, {name(rs1)}, {name(rs2)}" };
